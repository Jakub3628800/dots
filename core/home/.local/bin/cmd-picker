#!/usr/bin/env bash
# fzf picker: cmd-picker tmux | cmd-picker worktree [--print-path]
# Shell shortcuts: tm picks a session; wt picks a worktree and changes directory.
# Type to filter; arrows/Ctrl-J/Ctrl-K move; Enter selects; Ctrl-R refreshes;
# Esc/Ctrl-C cancels. Search state is not saved between actions.
# tmux: Enter attaches/switches, Ctrl-N creates, Ctrl-D confirms deletion.
# With no sessions, prompt for a name immediately; an empty name cancels.
# worktree: current tree first; Enter opens a child shell; --print-path instead
# prints only the selected path for wt. Unavailable directories cannot be opened.
# Ctrl-E opens EDITOR (one executable, default nvim); Ctrl-T opens a new window
# inside tmux. Editor/window failures return to the picker; other failures exit.
set -euo pipefail
mode=${1:-}
case "$mode:${2:-}:$#" in
tmux::1)
    header='Ctrl-N new · Ctrl-D delete'
    options=('--expect=ctrl-n,ctrl-d,ctrl-r' --delimiter=$'\t' --with-nth=2..)
    ;;
worktree::1 | worktree:--print-path:2)
    header='Ctrl-E editor'
    options=('--expect=ctrl-e,ctrl-r')
    if [[ -n ${TMUX:-} ]]; then
        header+=' · Ctrl-T tmux window'
        options=('--expect=ctrl-e,ctrl-t,ctrl-r')
    fi
    ;;
*)
    echo 'Usage: cmd-picker tmux|worktree [--print-path]' >&2
    exit 2
    ;;
esac
if [[ $mode == worktree ]]; then
    current=$(git rev-parse --show-toplevel 2>/dev/null && printf '.') || {
        echo 'cmd-picker: not inside a Git worktree' >&2
        exit 1
    }
    current=${current%$'\n.'}
fi
terminal=/dev/tty
for fd in 0 2 1; do
    if [[ -t $fd ]]; then
        terminal=$(tty <&"$fd")
        break
    fi
done
exec 3<>"$terminal"
result=$(mktemp -d)
trap 'rm -rf -- "$result"' EXIT

tmux_items() {
    { tmux list-sessions -F $'#{session_id}\t#{session_name} (#{session_windows} windows)' 2>/dev/null || :; } | tr '\n' '\0'
}
worktree_items() {
    printf '%s\0' "$current"
    git worktree list --porcelain -z | while IFS= read -r -d '' field; do
        [[ $field != 'worktree '* || $field == "worktree $current" ]] || printf '%s\0' "${field#worktree }"
    done
}
pick() {
    local status=0
    "$@" >"$result/items"
    if [[ $mode == tmux && ! -s $result/items ]]; then
        printf 'No tmux sessions. ' >&3
        key=ctrl-n item=''
        return
    fi
    FZF_DEFAULT_OPTS='' FZF_DEFAULT_OPTS_FILE='' fzf \
        --read0 --print0 --sync --height=80% --layout=reverse --no-multi --prompt="$mode> " \
        --header="$header · Ctrl-R refresh · Esc cancel" \
        "${options[@]}" <"$result/items" >"$result/choice" || status=$?
    ((status == 0 || status == 1)) || exit "$status"
    mapfile -d '' -t picked <"$result/choice"
    key=${picked[0]:-} item=${picked[1]:-}
}
while true; do
    pick "${mode}_items"
    [[ $key != ctrl-r ]] || continue
    [[ -n $item || $mode:$key == tmux:ctrl-n ]] || exit 1
    if [[ $mode == worktree ]]; then
        [[ -d $item ]] || continue
        if [[ -z $key && ${2:-} == --print-path ]]; then
            printf '%s\n' "$item"
            exit
        fi
    else
        item=${item%%$'\t'*}
    fi
    {
        case "$mode:$key" in
        tmux:ctrl-n)
            read -r -p 'New session name: ' name
            if [[ -z $name ]]; then
                [[ -s $result/items ]] || exit 1
                continue
            fi
            tmux new-session -d -s "$name"
            ;;
        tmux:ctrl-d)
            read -r -p 'Delete session? (y/N): ' answer
            [[ $answer != [yY] ]] || tmux kill-session -t "$item"
            ;;
        tmux:)
            operation=attach-session
            [[ -z ${TMUX:-} ]] || operation=switch-client
            tmux "$operation" -t "$item"
            exit
            ;;
        worktree:ctrl-e) "${EDITOR:-nvim}" "$item" || : ;;
        worktree:ctrl-t) if [[ -n ${TMUX:-} ]]; then tmux new-window -c "$item" -n "${item##*/}" || :; fi ;;
        worktree:)
            cd -- "$item"
            "${SHELL:-/bin/sh}"
            exit
            ;;
        esac
    } <&3 >&3 2>&3 3>&-
done
