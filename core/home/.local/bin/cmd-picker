#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///

import subprocess
import sys
import os
import shutil
import termios
import tty
import json
import webbrowser
import argparse
import re
from pathlib import Path
from typing import List, Dict, Any, TextIO
from abc import ABC, abstractmethod


ANSI_ESCAPE_RE = re.compile(
    r"""
    (?:\x1b\]|\x9d)[^\x07]*?(?:\x07|\x1b\\|\x9c|$)
    |\x1b(?:P|X|\^|_)[\s\S]*?(?:\x1b\\|$)
    |\x1b\[[0-?]*[ -/]*[@-~]
    |[\x90\x98\x9e\x9f][\s\S]*?(?:\x9c|$)
    |\x9b[0-?]*[ -/]*[@-~]
    |\x1b(?:\([0-2A-Z]|\)[0-2A-Z])
    |\x1b[@-_]
    """,
    re.DOTALL | re.VERBOSE,
)
CONTROL_CHAR_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")


def sanitize_terminal_text(value: object) -> str:
    """Remove terminal control sequences from externally sourced text."""
    text = ANSI_ESCAPE_RE.sub("", str(value))
    return CONTROL_CHAR_RE.sub("", text)


class Colors:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"

    BLACK = "\033[30m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"
    WHITE = "\033[37m"

    BG_BLACK = "\033[40m"
    BG_RED = "\033[41m"
    BG_GREEN = "\033[42m"
    BG_YELLOW = "\033[43m"
    BG_BLUE = "\033[44m"
    BG_MAGENTA = "\033[45m"
    BG_CYAN = "\033[46m"
    BG_WHITE = "\033[47m"

    BRIGHT_BLACK = "\033[90m"
    BRIGHT_RED = "\033[91m"
    BRIGHT_GREEN = "\033[92m"
    BRIGHT_YELLOW = "\033[93m"
    BRIGHT_BLUE = "\033[94m"
    BRIGHT_MAGENTA = "\033[95m"
    BRIGHT_CYAN = "\033[96m"
    BRIGHT_WHITE = "\033[97m"


class Tool(ABC):
    """Base class for all tools"""

    @property
    @abstractmethod
    def name(self) -> str:
        pass

    @property
    @abstractmethod
    def description(self) -> str:
        pass

    @abstractmethod
    def is_available(self) -> bool:
        pass

    @abstractmethod
    def get_items(self) -> List[Dict[str, Any]]:
        pass

    @abstractmethod
    def get_item_display(self, item: Dict[str, Any], selected: bool) -> str:
        pass

    @abstractmethod
    def get_item_preview(self, item: Dict[str, Any]) -> str:
        pass

    @abstractmethod
    def execute_action(self, item: Dict[str, Any]) -> None:
        pass

    def get_additional_actions(self) -> Dict[str, str]:
        """Return additional key bindings and their descriptions"""
        return {}

    def handle_additional_action(self, key: str, item: Dict[str, Any]) -> bool:
        """Handle additional actions. Return True if action was handled."""
        return False

    def can_create_new(self) -> bool:
        """Return True if this tool supports creating new items"""
        return False

    def create_new_item(self) -> bool:
        """Create a new item. Return True if items should be refreshed."""
        return False


class TmuxTool(Tool):
    @property
    def name(self) -> str:
        return "tmux"

    @property
    def description(self) -> str:
        return "Interactive tmux session picker"

    def is_available(self) -> bool:
        return shutil.which("tmux") is not None

    def get_items(self) -> List[Dict[str, Any]]:
        try:
            result = subprocess.run(
                ["tmux", "list-sessions", "-F", "#{session_name}\t#{session_windows}\t#{session_created}"],
                capture_output=True,
                text=True,
                check=True,
            )
            items = []
            for line in result.stdout.strip().split("\n"):
                if line.strip():
                    parts = line.split("\t")
                    if len(parts) >= 3:
                        items.append({"name": parts[0], "windows": parts[1], "created": parts[2], "type": "session"})
            return items
        except subprocess.CalledProcessError:
            return []

    def get_item_display(self, item: Dict[str, Any], selected: bool) -> str:
        name = sanitize_terminal_text(item["name"])
        windows = sanitize_terminal_text(item["windows"])
        if selected:
            return f"{Colors.BG_BLUE}{Colors.BRIGHT_WHITE}📺 {name}{Colors.RESET} {Colors.DIM}({windows} windows){Colors.RESET}"
        else:
            return f"{Colors.BRIGHT_CYAN}📺 {name}{Colors.RESET} {Colors.DIM}({windows} windows){Colors.RESET}"

    def get_item_preview(self, item: Dict[str, Any]) -> str:
        try:
            # Get session info
            session_info = subprocess.run(
                [
                    "tmux",
                    "display-message",
                    "-t",
                    item["name"],
                    "-p",
                    "#{session_name}: #{session_windows} windows, created #{session_created}",
                ],
                capture_output=True,
                text=True,
                check=True,
            ).stdout.strip()

            # Get window list
            windows = subprocess.run(
                [
                    "tmux",
                    "list-windows",
                    "-t",
                    item["name"],
                    "-F",
                    "#{window_index}: #{window_name} #{?window_active,(active),}",
                ],
                capture_output=True,
                text=True,
                check=True,
            ).stdout.strip()

            # Get preview of active window
            preview = subprocess.run(
                ["tmux", "capture-pane", "-t", item["name"], "-p"], capture_output=True, text=True, check=True
            ).stdout

            session_info = sanitize_terminal_text(session_info)
            windows = sanitize_terminal_text(windows)
            preview = sanitize_terminal_text(preview)[:500]
            return f"{Colors.CYAN}{session_info}{Colors.RESET}\n\n{Colors.YELLOW}Windows:{Colors.RESET}\n{Colors.GREEN}{windows}{Colors.RESET}\n\n{Colors.YELLOW}Preview:{Colors.RESET}\n{preview}..."
        except subprocess.CalledProcessError:
            name = sanitize_terminal_text(item["name"])
            return f"{Colors.RED}Unable to get info for session: {name}{Colors.RESET}"

    def execute_action(self, item: Dict[str, Any]) -> None:
        subprocess.run(["tmux", "attach-session", "-t", item["name"]])

    def get_additional_actions(self) -> Dict[str, str]:
        return {"d": "Delete session", "a": "New session"}

    def handle_additional_action(self, key: str, item: Dict[str, Any]) -> bool:
        if key == "d":
            name = sanitize_terminal_text(item["name"])
            print(f"\n{Colors.RED}Delete session '{name}'? (y/N): {Colors.RESET}", end="", flush=True)
            confirm = sys.stdin.read(1)
            if confirm.lower() == "y":
                try:
                    subprocess.run(["tmux", "kill-session", "-t", item["name"]], check=True)
                    return True
                except subprocess.CalledProcessError as exc:
                    print(
                        f"{Colors.RED}Failed to delete session '{name}': "
                        f"{sanitize_terminal_text(exc)}{Colors.RESET}"
                    )
        elif key == "a":
            return self.create_new_item()
        return False

    def can_create_new(self) -> bool:
        return True

    def create_new_item(self) -> bool:
        print(f"\n{Colors.CYAN}Enter new session name: {Colors.RESET}", end="", flush=True)
        try:
            session_name = input().strip()
            if session_name:
                try:
                    subprocess.run(["tmux", "new-session", "-d", "-s", session_name], check=True)
                    print(f"{Colors.GREEN}✓ Session '{sanitize_terminal_text(session_name)}' created{Colors.RESET}")
                    return True
                except subprocess.CalledProcessError as exc:
                    print(
                        f"{Colors.RED}✗ Failed to create session '{sanitize_terminal_text(session_name)}': "
                        f"{sanitize_terminal_text(exc)}{Colors.RESET}"
                    )
        except (EOFError, KeyboardInterrupt):
            pass
        return False


class DockerTool(Tool):
    @property
    def name(self) -> str:
        return "docker"

    @property
    def description(self) -> str:
        return "Interactive docker container picker"

    def is_available(self) -> bool:
        return shutil.which("docker") is not None

    def get_items(self) -> List[Dict[str, Any]]:
        try:
            result = subprocess.run(
                ["docker", "ps", "-a", "--format", "{{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Image}}"],
                capture_output=True,
                text=True,
                check=True,
            )
            items = []
            for line in result.stdout.strip().split("\n"):
                if line.strip():
                    parts = line.split("\t")
                    if len(parts) >= 4:
                        items.append(
                            {
                                "id": parts[0][:12],
                                "name": parts[1],
                                "status": parts[2],
                                "image": parts[3],
                                "type": "container",
                            }
                        )
            return items
        except subprocess.CalledProcessError:
            return []

    def get_item_display(self, item: Dict[str, Any], selected: bool) -> str:
        status_color = Colors.GREEN if "Up" in item["status"] else Colors.RED
        name = sanitize_terminal_text(item["name"])
        container_id = sanitize_terminal_text(item["id"])
        status = sanitize_terminal_text(item["status"])
        if selected:
            return f"{Colors.BG_BLUE}{Colors.BRIGHT_WHITE}🐳 {name}{Colors.RESET} {Colors.DIM}({container_id}){Colors.RESET} {status_color}{status}{Colors.RESET}"
        else:
            return f"{Colors.BRIGHT_CYAN}🐳 {name}{Colors.RESET} {Colors.DIM}({container_id}){Colors.RESET} {status_color}{status}{Colors.RESET}"

    def get_item_preview(self, item: Dict[str, Any]) -> str:
        try:
            # Get container details
            info_result = subprocess.run(
                [
                    "docker",
                    "inspect",
                    "--format",
                    "{{.Name}}: {{.Config.Image}}\nStatus: {{.State.Status}}\nCreated: {{.Created}}\nPorts: {{range $p, $conf := .NetworkSettings.Ports}}{{$p}}->{{(index $conf 0).HostPort}} {{end}}",
                    item["id"],
                ],
                capture_output=True,
                text=True,
                check=True,
            )

            # Get recent logs
            logs_result = subprocess.run(["docker", "logs", "--tail", "20", item["id"]], capture_output=True, text=True)

            logs = logs_result.stdout[-1000:] if logs_result.stdout else "No logs available"

            info = sanitize_terminal_text(info_result.stdout.strip())
            logs = sanitize_terminal_text(logs)
            return f"{Colors.CYAN}{info}{Colors.RESET}\n\n{Colors.YELLOW}Recent Logs:{Colors.RESET}\n{logs}"
        except subprocess.CalledProcessError:
            container_id = sanitize_terminal_text(item["id"])
            return f"{Colors.RED}Unable to get info for container: {container_id}{Colors.RESET}"

    def execute_action(self, item: Dict[str, Any]) -> None:
        if "Up" in item["status"]:
            subprocess.run(["docker", "exec", "-it", item["id"], "/bin/bash"])
        else:
            subprocess.run(["docker", "start", "-i", item["id"]])

    def get_additional_actions(self) -> Dict[str, str]:
        return {"s": "Start/Stop container", "l": "View logs"}

    def handle_additional_action(self, key: str, item: Dict[str, Any]) -> bool:
        if key == "s":
            try:
                if "Up" in item["status"]:
                    subprocess.run(["docker", "stop", item["id"]], check=True)
                else:
                    subprocess.run(["docker", "start", item["id"]], check=True)
                return True
            except subprocess.CalledProcessError as exc:
                print(
                    f"{Colors.RED}Docker action failed for {sanitize_terminal_text(item['id'])}: "
                    f"{sanitize_terminal_text(exc)}{Colors.RESET}"
                )
        elif key == "l":
            subprocess.run(["docker", "logs", "-f", item["id"]])
            return False
        return False


class GhTool(Tool):
    @property
    def name(self) -> str:
        return "gh"

    @property
    def description(self) -> str:
        return "Interactive GitHub pull request picker"

    def is_available(self) -> bool:
        return shutil.which("gh") is not None

    def get_items(self) -> List[Dict[str, Any]]:
        try:
            result = subprocess.run(
                [
                    "gh",
                    "pr",
                    "list",
                    "--json",
                    "number,title,author,state,url,headRefName,baseRefName,createdAt,updatedAt,additions,deletions,changedFiles",
                ],
                capture_output=True,
                text=True,
                check=True,
            )

            prs = json.loads(result.stdout)
            return prs if prs else []
        except (subprocess.CalledProcessError, json.JSONDecodeError):
            return []

    def get_item_display(self, item: Dict[str, Any], selected: bool) -> str:
        number = sanitize_terminal_text(item["number"])
        title = sanitize_terminal_text(item["title"])[:50]
        author = sanitize_terminal_text(item["author"]["login"])
        if selected:
            return f"{Colors.BG_BLUE}{Colors.BRIGHT_WHITE}🔀 #{number} {title}{Colors.RESET} {Colors.DIM}by {author}{Colors.RESET}"
        else:
            return f"{Colors.BRIGHT_CYAN}🔀 #{number} {title}{Colors.RESET} {Colors.DIM}by {author}{Colors.RESET}"

    def get_item_preview(self, item: Dict[str, Any]) -> str:
        try:
            # Get PR commits
            commits_result = subprocess.run(
                ["gh", "pr", "view", str(item["number"]), "--json", "commits"],
                capture_output=True,
                text=True,
                check=True,
            )

            commits_data = json.loads(commits_result.stdout)
            commits = commits_data.get("commits", [])

            commit_list = []
            for commit in commits[-5:]:
                short_sha = commit["oid"][:8]
                message = sanitize_terminal_text(commit["messageHeadline"])[:50]
                author = commit.get("author", {}).get("name", "Unknown") if commit.get("author") else "Unknown"
                commit_list.append(
                    f"{Colors.YELLOW}{sanitize_terminal_text(short_sha)}{Colors.RESET} {message} "
                    f"{Colors.DIM}({sanitize_terminal_text(author)}){Colors.RESET}"
                )

            # Get changed files
            files_result = subprocess.run(
                ["gh", "pr", "diff", str(item["number"]), "--name-only"], capture_output=True, text=True, check=True
            )

            files = files_result.stdout.strip().split("\n")[:10] if files_result.stdout.strip() else []

            number = sanitize_terminal_text(item["number"])
            title = sanitize_terminal_text(item["title"])
            author = sanitize_terminal_text(item["author"]["login"])
            head_branch = sanitize_terminal_text(item["headRefName"])
            base_branch = sanitize_terminal_text(item["baseRefName"])
            info = f"{Colors.CYAN}PR #{number}: {title}{Colors.RESET}\n"
            info += f"{Colors.DIM}Author: {author} | {head_branch} -> {base_branch}{Colors.RESET}\n"
            info += f"{Colors.GREEN}+{item.get('additions', 0)} -{item.get('deletions', 0)}{Colors.RESET} changes in {item.get('changedFiles', 0)} files\n\n"

            if commit_list:
                info += f"{Colors.YELLOW}Recent Commits:{Colors.RESET}\n" + "\n".join(commit_list) + "\n\n"

            if files:
                info += f"{Colors.YELLOW}Changed Files:{Colors.RESET}\n" + "\n".join(
                    f"{Colors.GREEN}{sanitize_terminal_text(f)}{Colors.RESET}" for f in files
                )

            return info
        except (subprocess.CalledProcessError, json.JSONDecodeError):
            number = sanitize_terminal_text(item["number"])
            return f"{Colors.RED}Unable to get info for PR #{number}{Colors.RESET}"

    def execute_action(self, item: Dict[str, Any]) -> None:
        webbrowser.open(item["url"])

    def get_additional_actions(self) -> Dict[str, str]:
        return {"c": "Checkout PR", "m": "Merge PR"}

    def handle_additional_action(self, key: str, item: Dict[str, Any]) -> bool:
        if key == "c":
            try:
                subprocess.run(["gh", "pr", "checkout", str(item["number"])], check=True)
                return False
            except subprocess.CalledProcessError as exc:
                print(
                    f"{Colors.RED}Failed to checkout PR #{sanitize_terminal_text(item['number'])}: "
                    f"{sanitize_terminal_text(exc)}{Colors.RESET}"
                )
        elif key == "m":
            number = sanitize_terminal_text(item["number"])
            print(f"\n{Colors.YELLOW}Merge PR #{number}? (y/N): {Colors.RESET}", end="", flush=True)
            confirm = sys.stdin.read(1)
            if confirm.lower() == "y":
                try:
                    subprocess.run(["gh", "pr", "merge", str(item["number"])], check=True)
                    return True
                except subprocess.CalledProcessError as exc:
                    print(
                        f"{Colors.RED}Failed to merge PR #{number}: "
                        f"{sanitize_terminal_text(exc)}{Colors.RESET}"
                    )
        return False


class WorktreeTool(Tool):
    """Pick among git worktrees for the current repository.

    The normal Enter action starts a nested shell with cwd set to the selected
    worktree. That is useful from a standalone process, but it cannot change the
    directory of the parent shell that launched cmd-picker.

    For real shell `cd` integration, use `cmd-picker worktree --print-path` from
    a shell function. In that mode only the selected path is printed to stdout;
    the interactive UI is written directly to /dev/tty (falling back to stderr)
    so command substitution can do:

        dir="$(cmd-picker worktree --print-path)" && cd "$dir"
    """

    @property
    def name(self) -> str:
        return "worktree"

    @property
    def description(self) -> str:
        return "Interactive git worktree picker"

    def is_available(self) -> bool:
        return shutil.which("git") is not None

    def _git(self, args: List[str], cwd: str | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
        return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, check=check)

    def _repo_root(self) -> str | None:
        try:
            return self._git(["rev-parse", "--show-toplevel"]).stdout.strip()
        except subprocess.CalledProcessError:
            return None

    def get_items(self) -> List[Dict[str, Any]]:
        root = self._repo_root()
        if root is None:
            return []

        try:
            # -z avoids git's path quoting and keeps unusual paths parseable.
            result = self._git(["worktree", "list", "--porcelain", "-z"], cwd=root)
        except subprocess.CalledProcessError:
            return []

        items: List[Dict[str, Any]] = []
        current: Dict[str, Any] = {}
        for entry in result.stdout.split("\0"):
            if not entry:
                if current:
                    items.append(current)
                    current = {}
                continue

            key, _, value = entry.partition(" ")
            if key == "worktree":
                current["path"] = value
                current["name"] = Path(value).name or value
            elif key == "HEAD":
                current["head"] = value[:12]
            elif key == "branch":
                current["branch"] = value.removeprefix("refs/heads/")
            elif key in {"bare", "detached", "prunable"}:
                current[key] = True

        if current:
            items.append(current)

        for item in items:
            item.setdefault("branch", "detached" if item.get("detached") else "unknown")
            item.setdefault("head", "")
            item["current"] = item.get("path") == root

        return sorted(items, key=lambda item: (not item.get("current", False), str(item.get("name", ""))))

    def get_item_display(self, item: Dict[str, Any], selected: bool) -> str:
        marker = "*" if item.get("current") else " "
        prunable = f" {Colors.RED}prunable{Colors.RESET}" if item.get("prunable") else ""
        prefix = f"{Colors.BG_BLUE}{Colors.BRIGHT_WHITE}" if selected else Colors.BRIGHT_CYAN
        name = sanitize_terminal_text(item["name"])
        branch = sanitize_terminal_text(item["branch"])
        path = sanitize_terminal_text(item["path"])
        return (
            f"{prefix}🌳{marker} {name}{Colors.RESET} "
            f"{Colors.GREEN}{branch}{Colors.RESET} "
            f"{Colors.DIM}{path}{Colors.RESET}{prunable}"
        )

    def get_item_preview(self, item: Dict[str, Any]) -> str:
        path = item["path"]
        info = [
            f"{Colors.CYAN}{sanitize_terminal_text(item['name'])}{Colors.RESET}",
            f"{Colors.DIM}Path: {sanitize_terminal_text(path)}{Colors.RESET}",
            f"{Colors.DIM}Branch: {sanitize_terminal_text(item['branch'])} | HEAD: {sanitize_terminal_text(item.get('head', ''))}{Colors.RESET}",
            "",
        ]

        try:
            status = self._git(["status", "--short", "--branch"], cwd=path).stdout.strip()
        except subprocess.CalledProcessError:
            status = "Unable to read status"

        try:
            commits = self._git(["log", "--oneline", "--decorate", "-5"], cwd=path).stdout.strip()
        except subprocess.CalledProcessError:
            commits = "Unable to read commits"

        return (
            "\n".join(info)
            + f"{Colors.YELLOW}Status:{Colors.RESET}\n{sanitize_terminal_text(status or 'Clean')}\n\n"
            + f"{Colors.YELLOW}Recent commits:{Colors.RESET}\n{sanitize_terminal_text(commits)}"
        )

    def execute_action(self, item: Dict[str, Any]) -> None:
        shell = os.environ.get("SHELL", "/bin/sh")
        subprocess.run([shell], cwd=item["path"])

    def get_additional_actions(self) -> Dict[str, str]:
        return {"e": "Open editor", "t": "Open tmux window"}

    def handle_additional_action(self, key: str, item: Dict[str, Any]) -> bool:
        if key == "e":
            editor = os.environ.get("EDITOR", "nvim")
            subprocess.run([editor, item["path"]])
            return False
        if key == "t":
            if shutil.which("tmux") is None:
                print(f"{Colors.RED}tmux is not available{Colors.RESET}")
                return False
            subprocess.run(["tmux", "new-window", "-c", item["path"], "-n", item["name"]], check=False)
            return False
        return False


class CmdPicker:
    def __init__(
        self,
        tool: Tool,
        output: TextIO = sys.stdout,
        input_stream: TextIO = sys.stdin,
        execute_on_select: bool = True,
    ):
        self.tool = tool
        self.output = output
        self.input_stream = input_stream
        self.execute_on_select = execute_on_select
        self.items: List[Dict[str, Any]] = []
        self.selected_index: int = 0
        self.preview_height: int = 20

    def get_key(self) -> str:
        """Get a single keypress"""
        fd = self.input_stream.fileno()
        old_settings = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            key = self.input_stream.read(1)
            if ord(key) == 27:  # ESC sequence
                key += self.input_stream.read(2)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        return key

    def display_interface(self) -> None:
        """Display the picker interface"""
        print("\033[H\033[2J", end="", file=self.output)

        if not self.items:
            print(f"{Colors.RED}No {self.tool.name} items found{Colors.RESET}", file=self.output)
            return

        # Get terminal size
        try:
            terminal_size = os.get_terminal_size(self.output.fileno())
            cols = terminal_size.columns
            rows = terminal_size.lines
        except (OSError, AttributeError):
            cols, rows = 80, 24

        width = cols

        # Calculate layout
        session_list_height = rows - self.preview_height - 5

        # Header with tool-specific emoji
        tool_emoji = {"tmux": "🚀", "docker": "🐳", "gh": "🔀", "worktree": "🌳"}.get(self.tool.name, "🎯")
        print(f"{Colors.BOLD}{Colors.BLUE}{'═' * width}{Colors.RESET}", file=self.output)
        print(
            f"{Colors.BOLD}{Colors.WHITE} {tool_emoji} {self.tool.name.upper()} Picker {Colors.RESET}{Colors.DIM}(j/k navigate, Enter select, q quit){Colors.RESET}",
            file=self.output,
        )
        print(f"{Colors.BOLD}{Colors.BLUE}{'═' * width}{Colors.RESET}", file=self.output)

        # Keep the selected item visible when the list is taller than the terminal.
        visible_count = max(1, session_list_height - 3)
        max_start = max(0, len(self.items) - visible_count)
        start = min(max(0, self.selected_index - visible_count + 1), max_start)
        for offset, item in enumerate(self.items[start : start + visible_count]):
            item_index = start + offset
            if item_index == self.selected_index:
                marker = f"{Colors.BRIGHT_GREEN}▶ {Colors.RESET}"
                display = self.tool.get_item_display(item, True)
            else:
                marker = f"{Colors.DIM}  {Colors.RESET}"
                display = self.tool.get_item_display(item, False)

            print(f"{marker}{display}", file=self.output)

        # Separator
        print(f"{Colors.YELLOW}{'─' * width}{Colors.RESET}", file=self.output)
        print(f"{Colors.BOLD}{Colors.YELLOW} 📋 Item Details & Preview{Colors.RESET}", file=self.output)
        print(f"{Colors.YELLOW}{'─' * width}{Colors.RESET}", file=self.output)

        # Display preview
        if self.items:
            selected_item = self.items[self.selected_index]
            preview = self.tool.get_item_preview(selected_item)
            preview_lines = preview.split("\n")

            # Show preview content
            available_lines = self.preview_height - 3  # Account for headers
            for i, line in enumerate(preview_lines[:available_lines]):
                # Truncate lines to fit terminal width
                truncated_line = line[: width - 1] if line else ""
                print(f"{Colors.DIM}{truncated_line}{Colors.RESET}", file=self.output)

        # Display controls at bottom
        controls = ["j/k: Navigate", "Enter: Select", "q: Quit"]
        additional_actions = self.tool.get_additional_actions()
        for key, desc in additional_actions.items():
            controls.append(f"{key}: {desc}")

        print(f"\n{Colors.DIM}Controls: {' | '.join(controls)}{Colors.RESET}", file=self.output)
        self.output.flush()

    def run(self) -> Dict[str, Any] | None:
        """Run the picker interface and return the selected item, if any."""
        if not self.tool.is_available():
            print(f"{Colors.RED}Error: {self.tool.name} is not available{Colors.RESET}", file=self.output)
            sys.exit(1)

        self.items = self.tool.get_items()

        if not self.items:
            print(f"{Colors.RED}No {self.tool.name} items found{Colors.RESET}", file=self.output)
            sys.exit(1)

        while True:
            self.display_interface()
            key = self.get_key()

            if key == "q":
                return None
            elif key in ["j", "\x1b[B"]:  # j or down arrow
                self.selected_index = min(len(self.items) - 1, self.selected_index + 1)
            elif key in ["k", "\x1b[A"]:  # k or up arrow
                self.selected_index = max(0, self.selected_index - 1)
            elif key == "\r":  # Enter
                selected_item = self.items[self.selected_index]
                print("\033[H\033[2J", end="", file=self.output)
                self.output.flush()
                if self.execute_on_select:
                    self.tool.execute_action(selected_item)
                return selected_item
            else:
                # Check additional actions
                if self.tool.handle_additional_action(key, self.items[self.selected_index]):
                    # Refresh items if action was handled and might have changed state
                    self.items = self.tool.get_items()
                    if not self.items:
                        return None
                    self.selected_index = min(self.selected_index, len(self.items) - 1)


TOOLS = {
    "tmux": TmuxTool(),
    "docker": DockerTool(),
    "gh": GhTool(),
    "worktree": WorktreeTool(),
}


def main():
    parser = argparse.ArgumentParser(
        description="Unified command picker for various tools",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"""
Available tools:
{chr(10).join(f"  {name}: {tool.description}" for name, tool in TOOLS.items())}

Examples:
  cmd-picker tmux      # Pick tmux sessions
  cmd-picker docker    # Pick docker containers
  cmd-picker gh        # Pick GitHub pull requests
  cmd-picker worktree  # Pick git worktrees
        """,
    )

    parser.add_argument("tool", nargs="?", choices=list(TOOLS.keys()), help="Tool to use for picking")
    parser.add_argument(
        "--print-path",
        action="store_true",
        help=(
            "For the worktree picker: print the selected worktree path to stdout "
            "instead of opening a shell. The UI is written directly to the terminal "
            "so shell functions can safely use command substitution and cd there."
        ),
    )

    args = parser.parse_args()

    if not args.tool:
        # Show available tools if no tool specified
        print(f"{Colors.BOLD}🎯 Command Picker{Colors.RESET}")
        print("Available tools:\n")
        for name, tool in TOOLS.items():
            available = "✅" if tool.is_available() else "❌"
            print(f"  {available} {Colors.GREEN}{name}{Colors.RESET}: {tool.description}")
        print("\nUsage: cmd-picker <tool>")
        return

    if args.print_path and args.tool != "worktree":
        parser.error("--print-path is only supported with the worktree tool")

    tool = TOOLS[args.tool]
    if args.print_path:
        # stdout must contain only the selected path for command substitution.
        # Use /dev/tty for the interactive UI so it remains visible even when
        # stdout is captured by: dir="$(cmd-picker worktree --print-path)".
        try:
            with open("/dev/tty", "r+") as tty_io:
                picker = CmdPicker(tool, output=tty_io, input_stream=tty_io, execute_on_select=False)
                selected_item = picker.run()
        except OSError:
            picker = CmdPicker(tool, output=sys.stderr, execute_on_select=False)
            selected_item = picker.run()
    else:
        picker = CmdPicker(tool)
        selected_item = picker.run()

    if args.print_path:
        if selected_item is None:
            sys.exit(1)
        print(selected_item["path"])


if __name__ == "__main__":
    main()
