#!/usr/bin/env bash
# pomo: run and record terminal Pomodoro sessions in a local SQLite database.
# Needs bash 5, the sqlite3 shell and GNU date; playerctl and notify-send are optional.
set -euo pipefail
# Let an exported COLUMNS set the bar width; bash would otherwise overwrite it.
shopt -u checkwinsize
# Session history is private: new directories get 0700, and the database and its
# journal files get 0600.
umask 077

VERSION=0.1.0
# Unlike $HOME, ~ still finds the home directory when HOME is unset.
DEFAULT_DB=~/.local/share/pomo/pomo.db
DB=${POMO_DB_PATH:-$DEFAULT_DB}
HELP="pomo - a lean pomodoro timer

Usage:
  pomo [flags]
  pomo --today
  pomo list [--after YYYY-MM-DD] [--before YYYY-MM-DD]
  pomo config [list]
  pomo config get <key>
  pomo config set <key> <value>

Timer flags:
  -d, --duration MINUTES   Duration in minutes
  -t, --tag TAG            Add a tag, can be repeated

Other flags:
  --today                  List today's sessions
  -h, --help               Show help
  --version                Show version

Environment:
  POMO_DB_PATH             Override database path
"
LIST_HELP="Usage:
  pomo list [--after YYYY-MM-DD] [--before YYYY-MM-DD]
"
CONFIG_HELP="Usage:
  pomo config [list]
  pomo config get <key>
  pomo config set <key> <value>

Config keys:
  default_duration_minutes
  music_control_enabled
  notifications_enabled
"
# Supported settings as an SQL table: key, default value and description.
SETTINGS="WITH setting(key, default_value, description) AS (VALUES
    ('default_duration_minutes', '25', 'Default timer duration in minutes.'),
    ('music_control_enabled', 'false', 'Run playerctl play/pause/stop during timer sessions.'),
    ('notifications_enabled', 'true', 'Run notify-send when a session completes.'))"
ACTIVE="status = 'running' AND end_time IS NULL"
# The progress bar is cut from these two strings.
BAR_DONE=##################################################
BAR_TODO=${BAR_DONE//#/-}

die() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

now() {
    date +%Y-%m-%dT%H:%M:%S%:z
}

# -batch keeps the plain output format even on a terminal, -init /dev/null skips
# ~/.sqliterc, and -- lets a relative database path start with a dash.
sql() {
    sqlite3 -batch -init /dev/null -cmd '.timeout 5000' -- "$DB" "$@"
}

# Print an SQL string literal for $1.
quote() {
    printf "'%s'" "${1//\'/\'\'}"
}

init_db() {
    mkdir -p -- "$(dirname -- "$DB")"
    # The umask covers new files; these repair modes left by older versions. Only
    # the default directory belongs to pomo, so a custom parent keeps its mode.
    [[ $DB != "$DEFAULT_DB" ]] || chmod 700 -- "${DB%/*}"
    sql "CREATE TABLE IF NOT EXISTS pomodori (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    start_time TEXT NOT NULL,
    end_time TEXT,
    duration_minutes INTEGER NOT NULL,
    status TEXT NOT NULL CHECK(status IN ('running', 'completed', 'cancelled')),
    tags TEXT,
    process_id INTEGER,
    created_at TEXT NOT NULL
);
CREATE UNIQUE INDEX IF NOT EXISTS pomodori_one_running ON pomodori(status) WHERE $ACTIVE;
CREATE TABLE IF NOT EXISTS config (key TEXT PRIMARY KEY, value TEXT, updated_at TEXT NOT NULL);
$SETTINGS INSERT OR IGNORE INTO config (key, value, updated_at)
SELECT key, default_value, '$NOW' FROM setting;"
    chmod 600 -- "$DB"
}

# The parse_* helpers store the normalized value in REPLY.
parse_minutes() {
    # [[:digit:]] is ASCII only, while [0-9] matches characters like ² in many locales.
    [[ $1 =~ ^[[:space:]]*([+-]?)0*([[:digit:]]+)[[:space:]]*$ ]] ||
        die 'duration must be an integer number of minutes'
    local sign=${BASH_REMATCH[1]} digits=${BASH_REMATCH[2]}
    # More than four digits is out of range, and could overflow bash arithmetic.
    if [[ $sign == - || ${#digits} -gt 4 ]] || ((10#$digits < 1 || 10#$digits > 1440)); then
        die 'duration must be between 1 and 1440 minutes'
    fi
    REPLY=$((10#$digits))
}

parse_bool() {
    [[ ${1,,} =~ ^[[:space:]]*(true|1|yes|on|false|0|no|off)[[:space:]]*$ ]] ||
        die 'boolean config values must be true or false'
    case ${BASH_REMATCH[1]} in
    true | 1 | yes | on) REPLY=true ;;
    *) REPLY=false ;;
    esac
}

parse_date() {
    # A valid date survives a round trip through date unchanged; years start at 0001.
    [[ $1 != 0000-* && $(date -ud "$1" +%F 2>/dev/null) == "$1" ]] ||
        die "invalid date '$1'; expected YYYY-MM-DD"
    REPLY=$1
}

check_key() {
    case $1 in
    default_duration_minutes | music_control_enabled | notifications_enabled) ;;
    *) die "unknown config key: $1" ;;
    esac
}

config_get() {
    check_key "$1"
    sql "$SETTINGS SELECT ifnull(value, default_value) FROM setting LEFT JOIN config USING (key)
WHERE key = '$1'"
}

# Run a desktop helper quietly if setting $1 is on; the helper may be missing.
run_if() {
    if [[ $(config_get "$1") == true ]]; then
        "${@:2}" >/dev/null 2>&1 || true
    fi
}

music() {
    run_if music_control_enabled playerctl "$1"
}

cancel_stale_session() {
    # The sqlite3 shell's readfile() returns NULL when the owner has no /proc entry.
    sql "UPDATE pomodori SET end_time = '$NOW', status = 'cancelled', process_id = NULL
WHERE $ACTIVE AND readfile('/proc/' || process_id || '/stat') IS NULL"
}

list_sessions() {
    local where="date(start_time, 'localtime') BETWEEN '$1' AND '$2'" output count rule
    cancel_stale_session
    # Read the rows, then their count, in one transaction. Tags may contain
    # newlines, and $(...) strips trailing ones, so the count must come last.
    # The ! flag makes printf pad by characters rather than bytes.
    output=$(sql "BEGIN;
SELECT printf('%-5d %-12s %-10s %-10s %-8s %!-32s', id,
    strftime('%Y-%m-%d', start_time, 'localtime'), duration_minutes || 'm', status,
    strftime('%H:%M', start_time, 'localtime'),
    CASE WHEN length(tags) > 32 THEN substr(tags, 1, 29) || '...' ELSE coalesce(tags, '') END)
FROM pomodori WHERE $where
ORDER BY julianday(start_time) DESC, id;
SELECT count(*) FROM pomodori WHERE $where;
COMMIT;")
    count=${output##*$'\n'}
    if ((count == 0)); then
        echo 'No pomodoro sessions recorded yet.'
        return
    fi
    printf -v rule '%*s' 96 ''
    rule=${rule// /-}
    echo "$rule"
    printf '%-5s %-12s %-10s %-10s %-8s %-32s\n' ID Date Duration Status Start Tags
    printf '%s\n' "$rule" "${output%$'\n'*}" "$rule" "Total: $count pomodoro sessions"
}

list_command() {
    local after=0001-01-01 before=9999-12-31
    while (($#)); do
        case $1 in
        -h | --help)
            printf '%s\n' "$LIST_HELP"
            exit 0
            ;;
        --after | --before)
            (($# > 1)) || die "$1 requires a value"
            # Handle "FLAG VALUE" as "FLAG=VALUE".
            set -- "$1=$2" "${@:3}"
            continue
            ;;
        --after=*)
            parse_date "${1#*=}"
            after=$REPLY
            ;;
        --before=*)
            parse_date "${1#*=}"
            before=$REPLY
            ;;
        *) die "unknown list argument: $1" ;;
        esac
        shift
    done
    list_sessions "$after" "$before"
}

config_command() {
    case ${1-list} in
    list)
        (($# <= 1)) || die 'config list does not accept arguments'
        sql "$SETTINGS SELECT printf('%-24s  %!-8s  %s', key, ifnull(value, default_value), description)
FROM setting LEFT JOIN config USING (key) ORDER BY key"
        ;;
    -h | --help | help) printf '%s\n' "$CONFIG_HELP" ;;
    get)
        (($# == 2)) || die 'usage: pomo config get <key>'
        config_get "$2"
        ;;
    set)
        (($# == 3)) || die 'usage: pomo config set <key> <value>'
        check_key "$2"
        if [[ $2 == default_duration_minutes ]]; then
            parse_minutes "$3"
        else
            parse_bool "$3"
        fi
        sql "UPDATE config SET value = '$REPLY', updated_at = '$NOW' WHERE key = '$2'"
        echo "$2 = $REPLY"
        ;;
    *) die "unknown config command: $1" ;;
    esac
}

render() {
    local remaining=$1 total=$2 label=$3 cols width filled seconds
    cols=$(tput cols 2>/dev/null) || cols=80
    width=$((cols < 20 ? 10 : cols > 60 ? 50 : cols - 10))
    filled=$(((total - remaining) * width / total))
    seconds=$((remaining / 1000000))
    printf '\e[H\e[2J\n  %02d:%02d%s\n  [%s%s]\n\n  p/space pause   q/esc quit\n' \
        $((seconds / 60)) $((seconds % 60)) "$label" "${BAR_DONE::filled}" "${BAR_TODO::width-filled}"
}

# Count down $1 minutes; succeed only if the timer completes.
countdown() {
    local total=$(($1 * 60000000)) remaining last current elapsed key paused=0
    remaining=$total
    # EPOCHREALTIME has six decimal places, so its digits alone count microseconds,
    # whatever decimal mark the locale uses.
    last=${EPOCHREALTIME//[!0-9]/}
    while ((!stop && remaining > 0)); do
        if ((paused)); then
            render "$remaining" "$total" ' paused'
        else
            render "$remaining" "$total" ''
        fi
        IFS= read -rsn1 -t 0.25 key || true
        current=${EPOCHREALTIME//[!0-9]/}
        elapsed=$((current - last))
        last=$current
        # Ignore suspend and wall-clock jumps: a tick lasts about 0.25s, so count
        # at most one second per tick, and nothing when the clock went backwards.
        if ((!paused && elapsed > 0)); then
            remaining=$((remaining - (elapsed > 1000000 ? 1000000 : elapsed)))
        fi
        case $key in
        q | $'\e' | $'\x03') stop=1 ;;
        p | ' ')
            paused=$((!paused))
            if ((paused)); then music pause; else music play; fi
            ;;
        esac
    done
    ((remaining <= 0)) || return 1
    render 0 "$total" ' completed'
}

finish() {
    stty "$saved_tty" 2>/dev/null || true
    music stop
    sql "UPDATE pomodori SET end_time = '$(now)', status = '$status', process_id = NULL WHERE id = $session_id"
    if [[ $status == completed ]]; then
        run_if notifications_enabled notify-send "pomo session ${minutes}m done"
        printf '\nCompleted.\n'
    else
        printf '\nCancelled.\n'
    fi
}

timer_command() {
    local tags=() tag_sql=NULL running
    minutes=
    while (($#)); do
        case $1 in
        -h | --help)
            printf '%s\n' "$HELP"
            exit 0
            ;;
        -d | --duration | -t | --tag)
            (($# > 1)) || die "$1 requires a value"
            # Handle "FLAG VALUE" as "FLAG=VALUE".
            set -- "$1=$2" "${@:3}"
            continue
            ;;
        -d=* | --duration=*)
            parse_minutes "${1#*=}"
            minutes=$REPLY
            ;;
        -t=* | --tag=*) tags+=("${1#*=}") ;;
        *) die "unknown timer argument: $1" ;;
        esac
        shift
    done
    cancel_stale_session
    running=$(sql "SELECT strftime('%Y-%m-%d %H:%M:%S', start_time, 'localtime') FROM pomodori WHERE $ACTIVE")
    [[ -z $running ]] || die "a pomodoro is already running since $running"
    [[ -t 0 ]] || die 'timer requires an interactive terminal'
    if [[ -z $minutes ]]; then
        parse_minutes "$(config_get default_duration_minutes)"
        minutes=$REPLY
    fi
    if ((${#tags[@]})); then
        printf -v tag_sql '%s,' "${tags[@]}"
        tag_sql=$(quote "${tag_sql%,}")
    fi
    # Signals end the countdown, which then records a cancelled session.
    stop=0
    trap 'stop=1' INT TERM HUP
    session_id=$(sql "INSERT OR IGNORE INTO pomodori
(start_time, duration_minutes, status, tags, process_id, created_at)
VALUES ('$NOW', $minutes, 'running', $tag_sql, $$, '$NOW') RETURNING id")
    [[ -n $session_id ]] || die 'a pomodoro is already running'
    status=cancelled
    saved_tty=$(stty -g)
    # Record the outcome however the script exits.
    trap finish EXIT
    stty -echo -icanon
    music play
    if countdown "$minutes"; then
        status=completed
    fi
}

main() {
    case ${1-} in
    -h | --help | help)
        printf '%s\n' "$HELP"
        return
        ;;
    --version)
        echo "pomo $VERSION"
        return
        ;;
    esac
    # The start time, used for every write except a session's end.
    NOW=$(now)
    init_db
    if [[ $# -eq 1 && $1 == --today ]]; then
        list_sessions "${NOW::10}" "${NOW::10}"
    elif [[ ${1-} == list ]]; then
        list_command "${@:2}"
    elif [[ ${1-} == config ]]; then
        config_command "${@:2}"
    else
        timer_command "$@"
    fi
}

main "$@"
